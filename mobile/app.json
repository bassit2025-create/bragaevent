{
  "expo": {
    "name": "Braga Event",
    "slug": "braga-event",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bragaevent",
    "userInterfaceStyle": "automatic",
    "primaryColor": "#ff5a3c",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "pt.bragaevent.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSCalendarsUsageDescription": "A Braga Event precisa de acesso ao teu calendário para adicionares eventos.",
        "NSCalendarsFullAccessUsageDescription": "A Braga Event precisa de acesso ao teu calendário para adicionares eventos."
      }
    },
    "android": {
      "package": "pt.bragaevent.app",
      "adaptiveIcon": {
        "backgroundColor": "#171310",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": ["READ_CALENDAR", "WRITE_CALENDAR"],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#171310",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "A Braga Event precisa de acesso ao teu calendário para adicionares eventos."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#ff5a3c"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
